digraph OutcomePreparationPrefix {
  graph [rankdir=TB, bgcolor="white", label="Retained outcome preparation and read-only materialization", labelloc=t, fontname="sans-serif", fontsize=18, nodesep=0.28, ranksep=0.38];
  node [shape=box, style="rounded,filled", fillcolor="#eef5fb", color="#2d5578", fontname="sans-serif", fontsize=12, margin="0.13,0.09"];
  edge [color="#2d5578", fontname="sans-serif", fontsize=10];
  start [shape=point, width=0.12, label=""];
  preparing [label="Original outcome worker\nOne-pass preparation"];
  capsule [label="Encoded save capsule retained\nExact save facts and transcript references"];
  hydration_failed [label="Transcript read unavailable\nEncoded capsule and owner retained", fillcolor="#fff5de"];
  raw [label="Complete captured input retained\nFull semantic outcome; no backend writes"];
  evidence [label="Executable evidence attached\nSame captured values and identities"];
  write [label="Original captured write attempted\nTransaction result may be uncertain"];
  proof_failed [label="Proof construction unavailable\nComplete input remains retained", fillcolor="#fff5de"];
  opaque [label="Opaque conversion failure\nOwner and error retained\nNo conversion replay", fillcolor="#fff5de"];
  captured [label="Existing captured-write recovery\nReconcile or explicit guarded retry\nPublish exact saved facts", fillcolor="#e7f5eb"];
  start -> preparing [label="Outcome work admitted"];
  preparing -> capsule [label="Completed encoding succeeds\n/ retain capsule"];
  preparing -> raw [label="Other supported kinds\n/ retain complete input"];
  preparing -> opaque [label="Failure before capsule"];
  capsule -> raw [label="Worker reads references\n/ construct input once"];
  capsule -> hydration_failed [label="Read fails / no outcome writes"];
  hydration_failed -> capsule [label="Later worker [owner + settled]\n/ retry captured reads"];
  capsule -> opaque [label="Input construction fails\n/ cache failure once"];
  hydration_failed -> hydration_failed [label="Read still unavailable\n/ retain responsibility"];
  raw -> evidence [label="Construct and attach proof"];
  raw -> proof_failed [label="Construction fails / no writes"];
  evidence -> write [label="Persist captured values"];
  write -> captured [label="Recovery [original physical settlement]"];
  proof_failed -> captured [label="Later worker [owner + settled]\n/ construct proof read-only"];
  proof_failed -> proof_failed [label="Proof unavailable / retain input"];
  opaque -> opaque [label="New observation / unavailable"];
  raw -> captured [style=dashed, label="Recovery worker\n/ classify; explicit writes only"];
  note [shape=note, fillcolor="#fff8df", color="#8b7846", label="Private stages of one existing Agent owner.\nA capsule is not complete input or write authority.\nOnly fixed immutable reads may repeat; input construction is one-shot.\nReconcile never writes; retry rechecks exact state and authority.\nClosed observers stay closed. Ordinary success is outside this view;\nno eventual business success is promised."];
  captured -> note [style=dashed, arrowhead=none];
}
