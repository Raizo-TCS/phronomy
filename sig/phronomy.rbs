module Phronomy
  VERSION: String

  class Error < StandardError
    attr_reader code: String?
    def initialize: (?untyped message, ?code: String?) -> void
    def self.diagnostic: (Exception) -> Hash[String, untyped]
    def self.from_diagnostic: (Hash[untyped, untyped], ?remaining: Integer) -> Error
  end

  class ParseError < Error
    attr_reader details: Array[Hash[String, untyped]]
    def initialize: (?untyped message, ?code: String?, ?details: Array[Hash[String, untyped]]) -> void
  end

  class ToolError < Error
  end

end
