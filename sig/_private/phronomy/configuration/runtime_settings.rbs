module Phronomy
  # Internal Engine-facing settings; application-specific types do not belong here.
  class RuntimeSettings
    def self.install_provider: () { () -> RuntimeSettings } -> void
    def self.current: () -> RuntimeSettings
    def initialize: (tracer: untyped) -> void
    attr_accessor tracer: untyped
    attr_accessor logger: untyped
    attr_accessor trace_pii: bool
    attr_accessor event_loop_stop_grace_seconds: Numeric
    attr_accessor event_loop_starvation_threshold_seconds: Numeric?
    attr_accessor event_loop_dispatch_threshold_seconds: Numeric?
    attr_accessor offload_pool_size: Integer
    attr_accessor offload_queue_size: Integer
  end

  class Configuration
    attr_reader __runtime_settings: RuntimeSettings
  end
end
