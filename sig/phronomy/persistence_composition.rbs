module Phronomy
  module PersistenceComposition
    class Stores < Data
      attr_reader coordinator: ::Phronomy::Persistence
      attr_reader agent: Agent::Store
      attr_reader team: MultiAgent::Store
      attr_reader workflow: _WorkflowStateRepository
      def self.new: (coordinator: ::Phronomy::Persistence, agent: Agent::Store, team: MultiAgent::Store, workflow: _WorkflowStateRepository) -> instance
    end

    def self.agent: (?backend: _StorageBackend?) -> Agent::Store
    def self.build: (backend: _StorageBackend) -> Stores
    def self.in_memory: () -> Stores
  end
end
