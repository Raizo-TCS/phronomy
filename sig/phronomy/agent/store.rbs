module Phronomy
  interface _AgentRepository
    def create: (untyped root) -> untyped
    def load: (String agent_id) -> untyped
    def save: (String agent_id, expected_revision: Integer, root: untyped) -> untyped
    def delete: (String agent_id) -> untyped
  end

  interface _JournalRepository
    def append: (String agent_id, expected_position: Integer, records: Array[untyped]) -> Array[untyped]
    def read: (String agent_id, ?after: Integer?, ?limit: Integer?) -> Array[untyped]
    def head: (String agent_id) -> Integer
    def delete: (String agent_id) -> untyped
  end

  interface _ExecutionRepository
    def create_active: (untyped execution) -> untyped
    def load: (String execution_id) -> untyped
    def save: (String execution_id, expected_revision: Integer, execution: untyped) -> untyped
    def list_active: (String agent_id) -> Array[untyped]
    def list: (String agent_id, ?after: String?, ?limit: Integer) -> Array[untyped]
    def delete: (String execution_id) -> untyped
    def delete_for_agent: (String agent_id) -> untyped
    def assert_idle!: (String agent_id) -> untyped
  end

  interface _HandoffStateRepository
    def load: (String main_agent_id) -> untyped
    def load_locked: (String main_agent_id) -> untyped
    def save: (String main_agent_id, expected_revision: Integer?, state: untyped) -> untyped
    def delete: (String main_agent_id, expected_revision: Integer) -> untyped
  end

  module Agent
    interface _Records
      def contents: () -> _ContentRepository
      def agents: () -> _AgentRepository
      def journals: () -> _JournalRepository
      def executions: () -> _ExecutionRepository
      def handoff_states: () -> _HandoffStateRepository
      def guard_agent!: (String agent_id) -> untyped
      def assert_agent_watermark!: (agent_id: String, agent_revision: Integer, journal_position: Integer) -> true
    end

    class Store
      class AuthorizedOperation < Data
        attr_reader invocation_id: String
        attr_reader name: String
        attr_reader arguments: Hash[String, untyped]
        def self.new: (invocation_id: String, name: String, arguments: Hash[String, untyped]) -> instance
      end

      attr_reader coordinator: ::Phronomy::Persistence
      attr_reader contents: _ContentRepository
      attr_reader agents: _AgentRepository
      attr_reader journals: _JournalRepository
      attr_reader executions: _ExecutionRepository
      attr_reader handoff_states: _HandoffStateRepository
      def initialize: (coordinator: ::Phronomy::Persistence, records: ::Phronomy::Persistence::_Participant[_Records]) -> void
      def transaction: [R] () { (_Records, ::Phronomy::Persistence::Transaction) -> R } -> R
      def participate: [R] (::Phronomy::Persistence::Transaction scope) { (_Records) -> R } -> R
      def exist?: (String agent_id) -> bool
      def authorized_operations: (::Phronomy::Persistence::Transaction scope, agent_id: String, execution_id: String, invocation_id: String, name: String, arguments: Hash[String, untyped], names: Array[String]) -> Array[AuthorizedOperation]
      def result: (String execution_id) -> Hash[Symbol, untyped]
      def runs: (String owner_id, ?after: String?, ?limit: Integer) -> Array[untyped]
      def handoff_result: (String execution_id, ?main_agent_id: String?) -> Hash[Symbol, untyped]
      def assert_agent_watermark!: (agent_id: String, agent_revision: Integer, journal_position: Integer) -> true
    end
  end
end
