module Phronomy
  module Agent
    # Coordination owns reservation semantics; Agent owns the acceptance operation.
    interface _AdmissionOwner
      def admit: (Admission admission) -> void
    end

    class Admission
      attr_reader agent_id: String
      attr_reader execution_id: String
      attr_reader correlation: Hash[String, untyped]?
      def initialize: (persistence: Store, root: untyped, input: String,
                       config: Hash[Symbol, untyped], preparation_metadata: Hash[String, untyped]) -> void
      def accept: () -> nil
      def accept_in: (::Phronomy::Persistence::Transaction scope) -> nil
      def result: () -> [untyped, untyped]
    end
  end
end
