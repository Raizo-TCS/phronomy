module Phronomy
  class ConfigurationError < Error
  end

  class HandoffError < Error
  end

  class CancellationError < Error
  end

  class EventLoopReentrancyError < Error
  end

  class AgentAlreadyExistsError < Error
  end

  class AgentPurgedError < Error
  end

  class PoolShutdownError < Error
  end

  class BackpressureError < Error
  end

  class Configuration
    attr_accessor agent_store: Agent::Store?
    attr_accessor multi_agent_store: MultiAgent::Store?
    attr_accessor workflow_store: _WorkflowStateRepository?
    attr_accessor llm_adapter: LLMAdapter::Base
    attr_accessor before_llm_input: Agent::_BeforeLLMInputHook?
  end

  def self.configuration: () -> Configuration
  def self.configure: () { (Configuration) -> void } -> void
end
